---
title: "Post a video from the CLI"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: done
    lg1: stopped
    lg2: resumable
    lg3: working
  }
  class lg0 teal
  class lg1 orange
  class lg2 yellow
  class lg3 blue
  s0: Run post create --video
  s1: Error, nothing to reuse
  s2: Uploaded, LinkedIn processing
  s3: Creating the post
  s4: Error names the video URN
  s5: Post published
  [*] --> s0
  s0 --> s1: the upload fails
  s0 --> s2: the file uploads
  s2 --> s1: LinkedIn cannot process the video
  s2 --> s3: processing finishes
  s2 --> s4: processing outlasts the wait
  s3 --> s4: the post call fails
  s3 --> s5: LinkedIn creates the post
  s4 --> s3: you rerun with --video-urn
  class s0 blue
  class s1 orange
  class s2 blue
  class s3 blue
  class s4 yellow
  class s5 teal
